diff --git a/kernel/core/init.c b/kernel/core/init.c
index e6562de..d0ee439 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -1,4 +1,5 @@
 #include <linux/export.h>
+#include <linux/fcntl.h>
 #include <linux/fs.h>
 #include <linux/kobject.h>
 #include <linux/module.h>
@@ -42,6 +43,10 @@ int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
 	ksu_handle_execveat_ksud(fd, filename_ptr,
 				 (struct user_arg_ptr *)argv,
 				 (struct user_arg_ptr *)envp, flags);
+	/* Match the syscall-hook sucompat contract.  In particular, never
+	 * change credentials for an invalid or unsupported execveat request. */
+	if (!fd || !flags || *fd != AT_FDCWD || *flags != 0)
+		return 0;
 	return ksu_handle_execveat_sucompat(fd, filename_ptr, argv, envp,
 					    flags);
 }
diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index f6bd4da..01d8484 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -240,7 +240,8 @@ int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
 	const char su[] = SU_PATH;
 	static const char ksud_path[] = KSUD_PATH;
 	struct ksu_sulog_pending_event *pending_root = NULL;
-	const char *const *sucompat_argv = (const char *const *)__never_use_argv;
+	struct file *ksud;
+	int ret;
 
 	if (unlikely(!filename_ptr))
 		return 0;
@@ -260,11 +261,25 @@ int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
 
 	pr_info("do_execveat_common su found\n");
 
-	pending_root = ksu_sulog_capture_root_execve_kern(filename->name, sucompat_argv, GFP_KERNEL);
+	/* The manual-hook argument is a struct user_arg_ptr holding user pointers,
+	 * not a kernel argv array.  Do not dereference it as kernel memory. */
+	pending_root = ksu_sulog_capture_root_execve_kern(filename->name, NULL, GFP_KERNEL);
 
-	memcpy((void *)filename->name, ksud_path, sizeof(ksud_path));
+	ret = escape_with_root_profile();
+	if (ret) {
+		ksu_sulog_emit_pending(pending_root, ret, GFP_KERNEL);
+		return 0;
+	}
 
-	escape_with_root_profile();
+	/* Mirror the syscall hook: permit bootstrap through sh before ksud
+	 * has been installed, instead of executing a nonexistent path. */
+	ksud = ksu_filp_open_compat(KSUD_PATH, O_RDONLY, 0);
+	if (IS_ERR(ksud)) {
+		memcpy((void *)filename->name, SH_PATH, sizeof(SH_PATH));
+	} else {
+		filp_close(ksud, NULL);
+		memcpy((void *)filename->name, ksud_path, sizeof(ksud_path));
+	}
 	ksu_sulog_emit_pending(pending_root, 0, GFP_KERNEL);
 
 	return 0;
