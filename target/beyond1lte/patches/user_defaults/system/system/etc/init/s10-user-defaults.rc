# One-time missing-value defaults only. Never override saved Bluetooth offload
# preferences after load_persist_props; that setting belongs to the user.
service s10-user-defaults /system/bin/sh /system/etc/s10-user-defaults.sh
    class late_start
    user shell
    group shell
    seclabel u:r:shell:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start s10-user-defaults
